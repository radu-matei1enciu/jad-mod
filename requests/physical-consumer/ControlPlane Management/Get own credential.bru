meta {
  name: Get own credential
  type: http
  seq: 7
}

get {
  url: http://localhost:7081/api/identity/v1alpha/credentials
  body: none
  auth: inherit
}

headers {
  x-api-key: password
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}
