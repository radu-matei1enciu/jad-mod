meta {
  name: 06 Get Contract Agreement
  type: http
  seq: 6
}

get {
  url: {{consumerCpBaseUrl}}/v5beta/participants/{{consumerParticipantContextId}}/contractnegotiations/{{contractNegotiationId}}/agreement
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

script:pre-request {
  if (!bru.getVar("accessToken")) {
    throw new Error("Missing accessToken. Run 00 Get Management Token first.");
  }

  if (!bru.getVar("consumerParticipantContextId")) {
    throw new Error("Missing consumerParticipantContextId. It should be physical-consumer.");
  }

  if (!bru.getVar("contractNegotiationId")) {
    throw new Error("contractNegotiationId is missing. Run 04 Initiate Contract Negotiation first.");
  }
}

script:post-response {
  const status = res.getStatus();
  const raw = res.getBody();

  let body;
  try {
    body = typeof raw === "string" ? JSON.parse(raw) : raw;
  } catch (e) {
    console.log("Raw response:", raw);
    throw new Error("Could not parse contract agreement response as JSON");
  }

  if (status < 200 || status >= 300) {
    console.log("HTTP status:", status);
    console.log("Contract agreement error response:", JSON.stringify(body, null, 2));
    throw new Error("Get contract agreement failed. Make sure 05 is FINALIZED first.");
  }

  console.log("Contract agreement response:");
  console.log(JSON.stringify(body, null, 2));

  const id =
    body["@id"] ||
    body["id"] ||
    body.contractAgreementId ||
    body["edc:contractAgreementId"];

  if (!id) {
    throw new Error("No contract agreement id found. Re-run 05 until negotiation is FINALIZED.");
  }

  bru.setVar("contractAgreementId", id);
  bru.setVar("CONTRACT_AGREEMENT_ID", id);

  const assetId =
    body.assetId ||
    body["edc:assetId"] ||
    body.asset?.["@id"] ||
    body.asset?.id;

  if (assetId) {
    bru.setVar("assetId", assetId);
    bru.setVar("ASSET_ID", assetId);
    console.log("Saved assetId from agreement:", assetId);
  } else {
    console.log("No assetId found in agreement response. Keeping existing assetId from catalog:", bru.getVar("assetId"));
  }

  console.log("Saved contractAgreementId:", id);
}
