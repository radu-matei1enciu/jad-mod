meta {
  name: 03 Initiate Contract Negotiation
  type: http
  seq: 4
}

post {
  url: {{consumerCpBaseUrl}}/v5beta/participants/{{consumerParticipantContextId}}/contractnegotiations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "@context": [
      "https://w3id.org/edc/connector/management/v2"
    ],
    "@type": "ContractRequest",
    "counterPartyAddress": "{{providerProtocolUrl}}",
    "counterPartyId": "{{providerDid}}",
    "protocol": "{{protocol}}",
    "policy": {{negotiationPolicy}},
    "callbackAddresses": []
  }
}

script:pre-request {
  if (!bru.getVar("accessToken")) {
    throw new Error("Missing accessToken. Run 00 Get Management Token first.");
  }

  if (!bru.getVar("consumerCpBaseUrl")) {
    bru.setVar("consumerCpBaseUrl", "http://localhost:9081/api/mgmt");
  }

  if (!bru.getVar("consumerParticipantContextId")) {
    bru.setVar("consumerParticipantContextId", "physical-consumer");
  }

  if (!bru.getVar("protocol")) {
    bru.setVar("protocol", "dataspace-protocol-http:2025-1");
  }

  if (!bru.getVar("providerProtocolUrl") || !bru.getVar("providerDid")) {
    throw new Error("Provider variables are missing. Run 01 Discover Virtual Providers first.");
  }

  if (!bru.getVar("assetId")) {
    throw new Error("assetId is missing. Run 03 Request Provider Catalog first.");
  }

  const offerPolicyRaw = bru.getVar("offerPolicy");

  if (!offerPolicyRaw) {
    throw new Error("offerPolicy is missing. Run 03 Request Provider Catalog first.");
  }

  let policy;
  try {
    policy = JSON.parse(offerPolicyRaw);
  } catch (e) {
    throw new Error("offerPolicy is not valid JSON: " + e.message);
  }

  // JAD/EDC contract negotiation requires these fields even if the catalog offer omitted them.
  if (!policy.assigner) {
    policy.assigner = bru.getVar("providerDid");
  }

  if (!policy.target) {
    policy.target = bru.getVar("assetId");
  }

  if (!policy["@type"]) {
    policy["@type"] = "Offer";
  }

  const negotiationPolicy = JSON.stringify(policy);

  bru.setVar("negotiationPolicy", negotiationPolicy);

  console.log("Consumer context:", bru.getVar("consumerParticipantContextId"));
  console.log("Provider DID:", bru.getVar("providerDid"));
  console.log("Provider protocol URL:", bru.getVar("providerProtocolUrl"));
  console.log("Asset ID:", bru.getVar("assetId"));
  console.log("Negotiation policy:", negotiationPolicy);
}

script:post-response {
  const status = res.getStatus();
  const raw = res.getBody();

  let body;
  try {
    body = typeof raw === "string" ? JSON.parse(raw) : raw;
  } catch (e) {
    console.log("Raw response:", raw);
    throw new Error("Could not parse contract negotiation response as JSON");
  }

  if (status < 200 || status >= 300) {
    console.log("HTTP status:", status);
    console.log("Contract negotiation error response:", JSON.stringify(body, null, 2));
    throw new Error("Contract negotiation request failed");
  }

  console.log("Contract negotiation response:");
  console.log(JSON.stringify(body, null, 2));

  const id =
    body["@id"] ||
    body["id"] ||
    body.contractNegotiationId ||
    body["edc:contractNegotiationId"];

  if (!id) {
    throw new Error("No negotiation id found in response");
  }

  bru.setVar("contractNegotiationId", id);
  bru.setVar("CONTRACT_NEGOTIATION_ID", id);

  console.log("Saved contractNegotiationId:", id);
}