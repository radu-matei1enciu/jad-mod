meta {
  name: 09 Consumer - Create Tenant
  type: http
  seq: 9
}

post {
  url: {{tmBaseUrl}}/tenants
  body: json
  auth: inherit
}

body:json {
  {
    "properties": {
      "name": "Consumer Tenant",
      "location": "eu"
    },
    "id":"foobar"
  }
}

script:post-response {
  let body = res.getBody()
  test("Response contains id", function () {
      expect(body).to.have.property("id");
  });
  
  if (body && body.id) {
      bru.setVar("consumer_tenant_id", body.id);
  }
}
