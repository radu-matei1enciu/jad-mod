+
+            // scope is in the inner "token" claim (DCP SI token structure)
+            var innerJwt = outerPayload.get("token");
+            if (innerJwt == null) {
+                monitor.debug("[extractScopesFromToken] no inner 'token' claim found");
+                return List.of();
+            }
+            monitor.debug("[extractScopesFromToken] found inner token, decoding...");
+
+            var innerPayload = decodeJwtPayload(innerJwt.toString());
+            if (innerPayload == null) return List.of();
+            monitor.debug("[extractScopesFromToken] inner claim keys: " + innerPayload.keySet());
+
+            var scope = innerPayload.get("scope");
+            monitor.debug("[extractScopesFromToken] inner scope claim: " + scope);
+            if (scope == null) {
+                monitor.debug("[extractScopesFromToken] no 'scope' claim in inner token");
+                return List.of();
