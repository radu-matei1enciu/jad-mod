+    private java.util.Map<String, Object> decodeJwtPayload(String jwt) {
+        try {
+            var parts = jwt.split("\\.");
+            if (parts.length < 2) return null;
+            var payload = new String(java.util.Base64.getUrlDecoder().decode(parts[1]),
+                    java.nio.charset.StandardCharsets.UTF_8);
+            var mapper = new com.fasterxml.jackson.databind.ObjectMapper();
+            return mapper.readValue(payload,
+                    new com.fasterxml.jackson.core.type.TypeReference<java.util.Map<String, Object>>() {});
+        } catch (Exception e) {
+            monitor.debug("[decodeJwtPayload] failed to decode: " + e.getMessage());
+            return null;
+        }
+    }
