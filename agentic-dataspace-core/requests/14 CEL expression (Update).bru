meta {
  name: 14 CEL expression (Update)
  type: http
  seq: 14
}

put {
  url: {{cpBaseUrl}}/v5beta/celexpressions/{{CEL_EXPR_ID}}
  body: json
  auth: inherit
}

body:json {
  {
    "@context": [
      "https://w3id.org/edc/connector/management/v2"
    ],
    "@type": "CelExpression",
    "@id": "{{CEL_EXPR_ID}}",
    "leftOperand": "AeroMembershipCredential",
    "scopes": [
      "catalog",
      "contract.negotiation",
      "transfer.process"
    ],
    "description": "Expression for evaluating membership credential",
    "expression": "ctx.agent.claims.vc.filter(c, c.type.exists(t, t == 'AeroMembershipCredential')).exists(c, c.credentialSubject.exists(cs, timestamp(cs.membershipStartDate) < now))"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
