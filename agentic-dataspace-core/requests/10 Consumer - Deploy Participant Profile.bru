meta {
  name: 10 Consumer - Deploy Participant Profile
  type: http
  seq: 10
}

post {
  url: {{tmBaseUrl}}/tenants/{{consumer_tenant_id}}/participant-profiles
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{$randomAlphaNumeric}}",
    "identifier": "{{consumer_did}}-{{$randomUUID}}",
    "properties": {},
    "cellId": "{{cell_id}}",
    "version": 0,
    "vpaProperties": {
      "cfm.issuer":{
        "key1": "value1",
        "bar": "baz"
      }    
    },
    "participantRoles": {
      "{{dataspace_id}}": [
        "manufacturer"
      ]
    },
    "properties": {
    }
  }
}

vars:pre-request {
  cell_id: 12084a60-b787-4caa-b450-97b36d9f5b97
}

script:post-response {
  let body = res.getBody()
  test("Response contains id", function () {
      expect(body).to.have.property("id");
  });
  
  if (body && body.id) {
      bru.setVar("consumer_profile_id", body.id);
  }
}
